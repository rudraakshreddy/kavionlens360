# Secrets
.env

# Raw data is never published (spec section 26: data minimisation)
data/raw/
# Extracts are regenerated by the pipeline (customer-level files are ~450 MB)
data/exports/

# Requirements PDF (private working document)
reference/

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Power BI local caches
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf

# Office lock files
~$*
